# ─── App ────────────────────────────────────────────────────────────────────
PORT=3333

# ─── Database ────────────────────────────────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://docker:docker@localhost:5432/helpdesk?schema=public"

# ─── JWT (RS256) ─────────────────────────────────────────────────────────────
# Gere um par de chaves RS256 e codifique em base64:
#
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem   →  JWT_PRIVATE_KEY
#   base64 -w 0 public.pem    →  JWT_PUBLIC_KEY
#
JWT_PRIVATE_KEY=<base64_da_chave_privada_RS256>
JWT_PUBLIC_KEY=<base64_da_chave_publica_RS256>

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ─── Supabase Storage ────────────────────────────────────────────────────────
# Crie um projeto em https://supabase.com e um bucket de armazenamento público
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
SUPABASE_STORAGE_BUCKET=<nome-do-bucket>
